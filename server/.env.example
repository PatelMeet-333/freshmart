# Copy this file to .env and fill it in. Never commit .env.

# Leave empty for local development: the server starts an in-memory MongoDB.
# For Atlas: mongodb+srv://<user>:<password>@<cluster>/freshmart?retryWrites=true&w=majority
MONGO_URI=

# At least 32 random characters in production.
JWT_SECRET=

# Website address(es), comma separated. Used for CORS and Cashfree's return link.
CLIENT_URL=http://localhost:5173
# This API's public address. Cashfree webhooks are only sent to https addresses.
API_URL=http://localhost:5000
PORT=5000

# mock = local test checkout, no Cashfree account needed (not allowed in production)
# sandbox = Cashfree test mode, production = real money
CASHFREE_MODE=mock
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# How long items are held while the customer pays.
PAYMENT_HOLD_MINUTES=15
# Not defined in the PID yet; set once the SRS confirms it.
DELIVERY_FEE=0
